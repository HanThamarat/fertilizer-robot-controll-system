# Base URL for the Express API (proxied to the backend in dev)
VITE_API_URL=/api

# "true" skips the server and accepts any email + password (UI work only)
VITE_AUTH_MOCK=false

# Default camera stream (MJPEG). ESP32-CAM: http://<cam-ip>:81/stream. Can also be set on the Controller page.
VITE_CAMERA_URL=
