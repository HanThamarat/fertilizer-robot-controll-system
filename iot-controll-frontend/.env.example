# Base URL for the Express API. Dev: /api (proxied to the backend).
# Production (Vercel): the Railway backend, e.g. https://<your-app>.up.railway.app/api
# The live socket connects to the same host.
VITE_API_URL=/api

# "true" skips the server and accepts any email + password (UI work only)
VITE_AUTH_MOCK=false

# Default camera stream (MJPEG). ESP32-CAM: http://<cam-ip>:81/stream. Can also be set on the Controller page.
VITE_CAMERA_URL=
