PORT=3000

FIREBASE_DATABASE_URL="FIREBASE_DATABASE_URL"

# First admin account. Created in Firebase (users/) on server start if it doesn't exist yet.
# The password is stored hashed (scrypt), never as plain text.
INITIAL_USER_EMAIL=admin@example.com
INITIAL_USER_PASSWORD=change-me
INITIAL_USER_NAME=Admin

# Secret used to sign sign-in tokens (JWT). Use a long random string.
JWT_SECRET=replace-with-a-long-random-string

# MQTT (ESP32 link)
# Leave MQTT_URL empty to run the built-in broker on MQTT_PORT; the ESP32 connects to mqtt://<this-pc-ip>:1883
# Or point at an external broker, e.g. mqtts://<host>.cloudamqp.com:8883 (TLS) or mqtt://broker.hivemq.com:1883
MQTT_URL=
MQTT_PORT=1883
# Broker login (ESP32 must use the same). CloudAMQP format: <vhost>:<user>
MQTT_USERNAME=
MQTT_PASSWORD=
# Topics: <prefix>/<robotId>/sensor/<deviceId>/<channel>
MQTT_TOPIC_PREFIX=fertbot
MQTT_ROBOT_ID=robot1
